/*
 * Not a device: the check for the keyboard that init makes at boot
 * (INIT_CHECK). It comes after the LCD, whose text routine it uses.
 */

#include "jp6502def.i65"

	.(

	.bss
kbdt	.byt 0		/* time left */
&&kbdwarm .byt 0	/* set by kinit: the boot was a jump to the reset
			   vector, not a reset of the board */
	.text

/*
 * Is there a keyboard? init asks at boot (INIT_CHECK). The controller
 * is reset with the board, and a second later tells whether it found
 * one: $ff yes, $fe no, sent like a key, with the handshake. The console
 * keeps it in kbdstat, and this waits up to about 5 s for it - as OS1
 * does. Port A itself says nothing before that: until the controller's
 * program runs, its lines float.
 *
 * "reset" in the shell only jumps to the reset vector, which leaves the
 * controller running - it tells nothing then. But its program runs, so
 * port A holds what it sent last, a status or a key: $fe means no
 * keyboard, anything else one.
 *
 * c=1 when there is none, or the controller does not tell: the message
 * is on the LCD then, and a/y point to it for init.
 */
&&kbd_check .(
	lda kbdwarm
	beq cold
	lda VIA3+VIA_DRBX	; port A without the handshake
	cmp #KBD_DISCONNECTED
	beq got
	lda #KBD_CONNECTED
	bne got
cold	lda #7*CLOCK_MHZ
	sta kbdt
l	lda kbdstat		; set in the interrupt
	bne got
	dey
	bne l
	dex
	bne l
	dec kbdt
	bne l
got	eor #KBD_CONNECTED	; 0 when there is a keyboard
	cmp #1
	bcc ok
	ldy #kbd_msgoff
	jsr lcd_text
	lda #<kbd_msg
	ldy #>kbd_msg
	sec
ok	rts
	.)

	.)
