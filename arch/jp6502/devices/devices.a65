/*
 * The device block of the JP6502. The order gives the device numbers:
 *
 *	0	ser1	ACIA, USB serial
 *	1	video1	first virtual console on the VDP and the keyboard
 *	2	video2	second one - Page Up switches
 *	3	lcd	the 20x4 LCD, output only
 *	4	nuldev
 */

	.(
	.word endd
	.byt PK_DEV+$80
	.word devstart
	.dsb P_NAME - P_RAM, $ff
	.asc "devices",0

devstart

-sernr = "1"
#include "devices/ser_jp.a65"

#define	CONSOLE_DEVICE	"devices/con_jp.a65"
#include "devices/console.a65"

#include "devices/lcd_jp.a65"

#include "devices/nulldev.a65"

	.word $ffff

/* not a device - used by the kernel and the console */
#include "devices/snd_jp.a65"

endd	.)

